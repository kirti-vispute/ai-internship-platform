# ---------------------------------------------------------------------------
# CareerSetu / InternAI backend - environment variables
# Copy to .env and fill in real values. Never commit .env (it is gitignored).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
# Comma-separated list of exact frontend origins allowed to call this API in
# production (no trailing slash, e.g. https://careersetu.vercel.app). CORS
# rejects every other origin once NODE_ENV=production.
CLIENT_URL=http://localhost:3000
# Set to "true" to additionally allow any *.vercel.app origin (per-PR preview
# deployments). Leave "false" in production unless previews need API access.
ALLOW_VERCEL_PREVIEW=false

# Required - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Required
MONGO_URI=mongodb://127.0.0.1:27017/internai

SCORER_ENABLED=false
AUTO_SEED=false

# ---------------------------------------------------------------------------
# AI (candidate scoring, matching explanations, cover-letter generation)
# Optional. Without a key below, every AI feature runs on deterministic
# local-heuristic fallbacks -- nothing breaks, results are just rule-based
# instead of LLM-generated.
# ---------------------------------------------------------------------------
ENABLE_AI=true

# Groq (recommended - fast, generous free tier):
#   1. Go to https://console.groq.com/keys
#   2. Sign in / create an account
#   3. Click "Create API Key", name it, copy the value (shown once)
#   4. Paste it below
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace Inference API (alternative/fallback provider):
#   1. Go to https://huggingface.co/settings/tokens
#   2. Create a token with "Read" access
HUGGINGFACE_API_KEY=

# When true (default), a local heuristic result is used whenever it produces
# usable content, and the LLM is only called when the heuristic can't answer.
# Set to false to always prefer the LLM when a key is configured.
AI_PREFER_LOCAL_HEURISTICS=true

# ---------------------------------------------------------------------------
# AI Job Agent - external job discovery
# ---------------------------------------------------------------------------
ENABLE_JOB_AGENT=true
# How often the background monitor scans for new matching jobs.
JOB_AGENT_SWEEP_INTERVAL_MS=3600000
# Minimum job-fit score (0-100) a job needs before it triggers an alert.
JOB_AGENT_MIN_FIT_SCORE_FOR_ALERT=60
# Max external listings fetched/upserted per discovery sweep (per provider).
JOB_AGENT_MAX_JOBS_PER_SWEEP=200

# Weights for the explainable 0-100 job-fit score. Must sum to 1 for the
# score to stay on a 0-100 scale. Defaults: role relevance and required
# skills matter equally most (a job in a clearly unrelated profession must
# not out-score a role mismatch just because it has no skills listed to
# fail against), then preferences, then preferred skills/experience
# equally, then eligibility.
JOB_AGENT_WEIGHT_ROLE_RELEVANCE=0.3
JOB_AGENT_WEIGHT_REQUIRED_SKILLS=0.3
JOB_AGENT_WEIGHT_PREFERRED_SKILLS=0.1
JOB_AGENT_WEIGHT_EXPERIENCE=0.1
JOB_AGENT_WEIGHT_ELIGIBILITY=0.05
JOB_AGENT_WEIGHT_PREFERENCES=0.15

# Remotive (https://remotive.com) - software/data/AI remote jobs, including
# internships. Fully free, keyless, no signup needed. On by default.
JOB_PROVIDER_REMOTIVE_ENABLED=true

# Adzuna (https://developer.adzuna.com) - adds real India-specific listings
# (Bangalore, Pune, Mumbai, etc.) alongside Remotive's remote-only feed.
# Free registration required (no cost, no card):
#   1. Go to https://developer.adzuna.com/ and click "Register"
#   2. After signing up, your App ID and App Key are shown on your account
#      page (https://developer.adzuna.com/admin/application)
#   3. Paste both below
# The free tier (25 req/min, 250/day) is for non-commercial/evaluation use,
# which covers a student project; a paid licence is only needed if this
# were turned into a revenue-generating product. Until these are set, the
# Job Agent simply skips Adzuna and still works fine with Remotive + your
# own CareerSetu internship listings.
JOB_PROVIDER_ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Arbeitnow (https://www.arbeitnow.com/api/job-board-api), The Muse
# (https://www.themuse.com/developers/api/v2 - the only provider with a
# real provider-stated "Internship" level facet) and Remote OK
# (https://remoteok.com/api) are all free, keyless public APIs. On by
# default, same as Remotive -- nothing to configure.
JOB_PROVIDER_ARBEITNOW_ENABLED=true
JOB_PROVIDER_THEMUSE_ENABLED=true
JOB_PROVIDER_REMOTEOK_ENABLED=true

# Greenhouse and Lever -- legitimate "company career pages" integration.
# Companies using these ATS platforms publish a free, keyless, official
# JSON API for their own open roles (the same data their /careers page
# renders) -- this is not scraping. Each is a comma-separated list of
# company board tokens/slugs (visible in that company's own career-page
# URL, e.g. boards.greenhouse.io/<token> or jobs.lever.co/<slug>). Empty
# by default (skipped, "no board tokens configured") -- add real,
# permitted companies you want covered. Verified-working examples used
# during development (public company boards, safe to try):
JOB_PROVIDER_GREENHOUSE_ENABLED=true
JOB_PROVIDER_GREENHOUSE_BOARD_TOKENS=
# e.g. JOB_PROVIDER_GREENHOUSE_BOARD_TOKENS=stripe,airbnb
JOB_PROVIDER_LEVER_ENABLED=true
JOB_PROVIDER_LEVER_COMPANY_SLUGS=
# e.g. JOB_PROVIDER_LEVER_COMPANY_SLUGS=spotify

# Jooble (https://jooble.org/api/about) - free-tier aggregator, registration
# required (no cost):
#   1. Go to https://jooble.org/api/about and request an API key
#   2. Paste it below
# Skipped (no-op) until configured, same pattern as Adzuna.
JOB_PROVIDER_JOOBLE_ENABLED=true
JOOBLE_API_KEY=

# Naukri, LinkedIn, Indeed, Wellfound: investigated and NOT integrated --
# none currently offers a legitimate self-serve public API for pulling job
# search results (only partner/employer-side programs, which is the
# opposite direction this feature needs). See
# backend/src/modules/job-agent/providers/{naukri,linkedin,indeed,wellfound}.provider.js
# for the full investigation notes and the real path to get each one
# connected (partnership applications), should one later be approved.

# ---------------------------------------------------------------------------
# Email notifications (optional - in-app notifications work without this)
# Gmail SMTP via nodemailer. Use a Google "App Password", not your real
# account password: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# File storage (optional - defaults to local disk under backend/uploads)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=internai

# ---------------------------------------------------------------------------
# Redis cache (optional - AI response caching falls back to in-memory)
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
