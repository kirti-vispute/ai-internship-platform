# ---------------------------------------------------------------------------
# CareerSetu / InternAI frontend - environment variables
# Copy to .env.local for local dev. In Vercel/Netlify, set these as project
# environment variables instead (never commit .env.local).
# All NEXT_PUBLIC_* vars are inlined into the client bundle at build time --
# never put a secret in one.
# ---------------------------------------------------------------------------

# Backend API origin (no trailing slash). Point this at the deployed Render
# service in staging/production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# This frontend's own public origin (used for canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only if the Render backend is also configured with
# ALLOW_VERCEL_PREVIEW=true, so CORS accepts Vercel's per-PR preview domains.
# ALLOW_VERCEL_PREVIEW is a backend-side flag; nothing to set here.

# Feature flags (all optional, default shown)
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_RECORDINGS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_INTERVIEW_ROOMS=true
NEXT_PUBLIC_ENABLE_3D_PORTFOLIO=true
NEXT_PUBLIC_ENABLE_JOB_AGENT=true

# Build/version metadata (optional -- auto-generated if unset)
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_BUILD=
